# SearchNex Ads — environment variables
#
# EVERY variable the app reads is listed here; tests/test_env_example.py fails CI if the
# code reads one that isn't. On Railway, set them as service variables. For local dev,
# copy this file to `.env` (git-ignored) and run:
#     uvicorn backend.main:app --reload --port 8000 --env-file .env
#
# Local dev needs NONE of them: no DATABASE_URL = SQLite at data/dev.db; no LLM key =
# heuristic search-term relevance; no Google Ads keys = file uploads only; no BigQuery
# settings = everything stays in Postgres/SQLite.

# ──────────── DATABASE ────────────
# Postgres (Railway). Unset -> local SQLite file data/dev.db.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ──────────── BIGQUERY ANALYTICS WAREHOUSE ────────────
# raw_rows / qs_history live in BigQuery only when GCP_PROJECT and BQ_DATASET are both set
# AND USE_BIGQUERY is on. USE_BIGQUERY is the cutover switch: unsetting it is the instant
# rollback. Provisioning / migration / parity scripts only need the two config vars.
# GCP_PROJECT=your-gcp-project
# BQ_DATASET=searchnex_ads
# BQ_LOCATION=US                     # default: US
# USE_BIGQUERY=1                     # 1/true/yes/on
# Service-account key as INLINE JSON (the value must start with "{").
# Unset -> Google Application Default Credentials (e.g. GOOGLE_APPLICATION_CREDENTIALS=/path/key.json).
# GCP_SA_KEY={"type":"service_account", ...}

# ──────────── GOOGLE ADS API (automatic sync) ────────────
# All five are required for API sync. The Ads API screen lists any that are missing
# (names only, never values). Get a refresh token with scripts/get_refresh_token.py.
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_CLIENT_ID=xxxx.apps.googleusercontent.com
# GOOGLE_ADS_CLIENT_SECRET=
# GOOGLE_ADS_REFRESH_TOKEN=
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=1234567890        # the MCC / manager account id (dashes are stripped)
# Shared secret the scheduled caller must send as the X-Cron-Token header to
# POST /api/cron/adsapi-sync. Unset or wrong -> 403.
# ADSAPI_CRON_SECRET=long-random-string
# Copy of the Railway cron expression (5 fields, UTC). Only used to show the next-sync
# countdown in the UI; the actual schedule lives in Railway.
# ADSAPI_CRON_SCHEDULE=0 6 * * *

# ──────────── SEARCH-TERM RELEVANCE (LLM) ────────────
# Anthropic is used first. DeepSeek only when its key is set and no Anthropic key is (the
# explicit opt-in: search terms can contain PII). Neither -> deterministic heuristic.
# ANTHROPIC_API_KEY=
# RELEVANCE_MODEL=claude-haiku-4-5-20251001      # Anthropic model (default shown)
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat                   # default shown
# DEEPSEEK_URL=https://api.deepseek.com/chat/completions

# ──────────── MAP TILES (React console, BUILD time) ────────────
# Vite bakes this into the JavaScript during the build; the Dockerfile declares it as a
# build ARG so Railway passes it. Changing it needs a rebuild. Unset -> OpenStreetMap tiles.
# VITE_MAPTILER_KEY=

# ──────────── CONTAINER ────────────
# The port uvicorn listens on. Railway injects it; default 8000. A Railway domain must target
# the port shown in the deploy log line "Uvicorn running on http://0.0.0.0:<port>".
# PORT=8000
